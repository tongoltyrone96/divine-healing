# Copy this file to `.env` and fill in real values. `.env` itself is gitignored.
#
# Flutter reads these at build time via `--dart-define`. Use the helper script
# `run_local.ps1` (or wire your own) to load .env and pass each key as
# `--dart-define=KEY=VALUE`.
#
# During M1 the app runs fine with all of these empty (local JSON mode).

# ------------------------------------------------------------------
# Supabase (backend + auth + storage)
# Project Settings > API in the Supabase dashboard
# ------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...        # the "anon public" key (NOT service_role)

# ------------------------------------------------------------------
# RevenueCat (subscriptions — Apple IAP + Google Billing + Stripe wrapper)
# Get these from https://app.revenuecat.com after creating the app
# ------------------------------------------------------------------
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
